generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  h1              String?
  excerpt         String?
  content         String // HTML
  coverImage      String?
  category        String   @default("Kiến thức")
  tags            String   @default("") // CSV
  metaTitle       String?
  metaDescription String?
  faqJson         String? // JSON: [{q,a}] cho FAQPage (AEO)
  phone           String? // Hotline riêng cho bài này (trống = hotline mặc định)
  published       Boolean  @default(true)
  views           Int      @default(0)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([published, publishedAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id           String       @id @default(cuid())
  trackingCode String       @unique
  senderName   String
  receiverName String
  origin       String       @default("Việt Nam")
  destination  String
  weight       Float?
  status       String       @default("Đã tiếp nhận")
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  events       OrderEvent[]
}

model OrderEvent {
  id       String   @id @default(cuid())
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status   String
  location String?
  note     String?
  at       DateTime @default(now())

  @@index([orderId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  route     String?
  weight    String?
  cargoType String?
  message   String?
  status    String   @default("Mới")
  createdAt DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  src       String
  caption   String   @default("")
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sort])
}

/// Mỗi lần khách bấm "Tính ước tính" trên công cụ tính cước.
/// Không lưu gì nhận dạng được khách — sessionId là chuỗi ngẫu nhiên sinh ở
/// trình duyệt, chỉ để phân biệt "một người bấm 5 lần" với "5 người bấm".
model QuoteLog {
  id         String   @id @default(cuid())
  dest       String
  destLabel  String
  weight     Float
  cargo      String
  dims       String?
  page       String
  /// "price" = tính ra giá, "contact" = tuyến/cân ngoài bảng giá nên phải gọi hỏi
  mode       String
  priceTotal Int?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Khách làm gì SAU khi xem giá trên công cụ tính cước: bấm Zalo, bấm Gọi, hay
/// để lại SĐT. Nối với QuoteLog qua sessionId để đo "tính giá xong rồi liên hệ".
model QuoteAction {
  id        String   @id @default(cuid())
  sessionId String?
  /// "zalo" | "call" | "lead"
  action    String
  dest      String?
  weight    Float?
  page      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}

/// 1 lượt xem trang của khách thật (bộ đo chạy bằng JS nên bot không đếm vào).
/// Không lưu IP / tên / số điện thoại.
model Visit {
  id          String   @id
  sessionId   String
  /// Ngẫu nhiên trong localStorage — chỉ để biết khách quay lại, không nhận dạng được ai.
  visitorId   String?
  path        String
  title       String?
  /// Nguồn của CẢ PHIÊN: google-ads | google | chatgpt | perplexity | gemini | copilot | claude | facebook | zalo | coccoc | direct | other
  source      String
  refHost     String?
  landing     Boolean  @default(false)
  device      String
  durationSec Int      @default(0)
  maxScroll   Int      @default(0)
  /// Tiêu đề mục (H2) xa nhất khách đọc tới trước khi rời trang
  lastSection String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([path])
}

/// Khách bấm gì: call | copy-phone | zalo | link-out | form
model VisitEvent {
  id        String   @id @default(cuid())
  sessionId String
  visitId   String?
  path      String
  type      String
  /// Nút nằm ở đâu (id khối gần nhất, vd floating-call) hoặc chữ trên nút
  label     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}

/// Bot tìm kiếm / AI đọc trang nào, gom theo ngày từ log nginx (scripts/ai-crawl-sync.py).
model AiCrawl {
  id       String  @id @default(cuid())
  day      String
  bot      String
  /// user = có người đang hỏi AI và AI mở trang ra đọc | search = lập chỉ mục để trích dẫn | training = lấy dữ liệu huấn luyện
  kind     String
  path     String
  hits     Int
  verified Boolean

  @@unique([day, bot, path])
  @@index([day])
}
